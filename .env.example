# SafeSteps Environment Configuration
# Copy this file to .env.local for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.
#
# IMPORTANT:
# Do NOT prefix API keys with NEXT_PUBLIC_. The keys are server-only
# and must never appear in client bundles or network requests.

# Groq API Key from Groq Console (https://console.groq.com/) - 14,400 requests/day free tier
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Verified: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# ==============================================================================
# Supabase Configuration
# ==============================================================================

# Supabase Project URL (Public / Browser & Server)
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
# Safe to expose in the browser (prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon API Key (Public / Browser & Server)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon (public)
# Subject to Row Level Security (RLS) policies. Safe for client-side use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# Bypasses Row Level Security (RLS). Must NEVER be prefixed with NEXT_PUBLIC_ or bundled into the browser.
# Used exclusively for server-side administration (e.g. data ingestion scripts, permanent account deletion).
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Gemini Embeddings Configuration
# ==============================================================================

# Gemini Embedding Model for vector embeddings (Default: gemini-embedding-001)
# Used for semantic search, clinical knowledge retrieval (RAG), and vector embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
